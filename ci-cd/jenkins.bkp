#!/bin/bash
set -Eeuo pipefail
umask 022

exec > >(tee -a /var/log/jenkins-bootstrap.log | logger -t jenkins-bootstrap -s 2>/dev/console) 2>&1
trap 'rc=$?; echo "ERROR: line $LINENO: $BASH_COMMAND (exit=$rc)" >&2; exit "$rc"' ERR

# Prevent simultaneous bootstrap runs.
exec 9>/run/jenkins-bootstrap.lock
if ! flock -n 9; then
  echo "Another Jenkins bootstrap is already running."
  exit 1
fi

echo "========== Jenkins Controller Setup =========="

JENKINS_HOME="/var/lib/jenkins"
DATA_DEVICE="/dev/nvme1n1"
JENKINS_WAR="/usr/share/java/jenkins.war"

PLUGIN_MANAGER_VERSION="2.15.0"
PLUGIN_MANAGER_JAR="/opt/jenkins/jenkins-plugin-manager.jar"
PLUGIN_STAGING="/var/cache/jenkins-plugin-manager/plugins"
PLUGIN_LIST="/etc/jenkins/plugins.txt"
JENKINS_REPO="/etc/yum.repos.d/jenkins.repo"
JENKINS_OVERRIDE_DIR="/etc/systemd/system/jenkins.service.d"
JENKINS_OVERRIDE="$${JENKINS_OVERRIDE_DIR}/override.conf"

RESTART_REQUIRED=0

# 1. Install required packages.
dnf install -y \
  fontconfig java-21-amazon-corretto \
  git rsync xfsprogs unzip wget jq zip tar \
  which vim curl-minimal openssh-clients

java -version

# 2. Configure Jenkins repository only when content differs.
REPO_TMP=$(mktemp)
cat > "$REPO_TMP" <<'REPO'
[jenkins]
name=Jenkins Stable
baseurl=https://pkg.jenkins.io/rpm-stable
gpgcheck=1
gpgkey=https://pkg.jenkins.io/rpm-stable/jenkins.io-2026.key
REPO

if ! cmp -s "$REPO_TMP" "$JENKINS_REPO" 2>/dev/null; then
  install -o root -g root -m 0644 "$REPO_TMP" "$JENKINS_REPO"
fi
rm -f "$REPO_TMP"

rpm --import https://pkg.jenkins.io/rpm-stable/jenkins.io-2026.key

if ! rpm -q jenkins >/dev/null 2>&1; then
  dnf install -y jenkins
  RESTART_REQUIRED=1
else
  # Permit normal package updates, but only restart if Jenkins changes.
  if dnf -y upgrade jenkins; then
    :
  else
    echo "WARNING: Jenkins package upgrade failed; continuing with installed version."
  fi
fi

# 3. Validate the dedicated EBS data volume.
if [ ! -b "$DATA_DEVICE" ]; then
  echo "ERROR: EBS data device not found: $DATA_DEVICE"
  lsblk -f
  exit 1
fi

FSTYPE=$(blkid -o value -s TYPE "$DATA_DEVICE" || true)
VOLUME_UUID=$(blkid -s UUID -o value "$DATA_DEVICE" || true)

if [ "$FSTYPE" != "xfs" ] || [ -z "$VOLUME_UUID" ]; then
  echo "ERROR: Expected an existing XFS filesystem with UUID on $DATA_DEVICE"
  lsblk -f
  echo "No automatic formatting will be attempted."
  exit 1
fi

mkdir -p "$JENKINS_HOME"

# Ensure there is no conflicting fstab mount for Jenkins home.
FSTAB_MOUNT=$(awk '
  /^[[:space:]]*#/ { next }
  NF >= 2 && $2 == "/var/lib/jenkins" { print $1, $3 }
' /etc/fstab)

EXPECTED_FSTAB="UUID=$VOLUME_UUID xfs"

if [ -n "$FSTAB_MOUNT" ]; then
  if [ "$FSTAB_MOUNT" != "$EXPECTED_FSTAB" ]; then
    echo "ERROR: Conflicting /etc/fstab entry for $JENKINS_HOME:"
    echo "$FSTAB_MOUNT"
    exit 1
  fi
else
  printf 'UUID=%s %s xfs defaults,nofail 0 2\n' \
    "$VOLUME_UUID" "$JENKINS_HOME" >> /etc/fstab
fi

# Mount the volume if necessary; verify its UUID afterward.
if ! mountpoint -q "$JENKINS_HOME"; then
  mount "$JENKINS_HOME"
fi

MOUNT_SOURCE=$(findmnt -n -o SOURCE --target "$JENKINS_HOME")
MOUNT_UUID=$(blkid -s UUID -o value "$MOUNT_SOURCE" 2>/dev/null || true)

if [ "$MOUNT_UUID" != "$VOLUME_UUID" ]; then
  echo "ERROR: $JENKINS_HOME is not mounted from the expected EBS filesystem."
  findmnt --target "$JENKINS_HOME" || true
  exit 1
fi

echo "Verified EBS mount:"
findmnt --target "$JENKINS_HOME"

# 4. Define the desired plugin list.
mkdir -p /etc/jenkins /opt/jenkins "$PLUGIN_STAGING"
mkdir -p "$JENKINS_HOME/plugins"

PLUGIN_TMP=$(mktemp)
cat > "$PLUGIN_TMP" <<'PLUGINS'
configuration-as-code
workflow-aggregator
git
github-branch-source
pipeline-stage-view
pipeline-utility-steps
pipeline-groovy-lib
credentials
credentials-binding
ssh-agent
sonar
nexus-artifact-uploader
ansible
PLUGINS

if ! cmp -s "$PLUGIN_TMP" "$PLUGIN_LIST" 2>/dev/null; then
  install -o root -g root -m 0644 "$PLUGIN_TMP" "$PLUGIN_LIST"
  RESTART_REQUIRED=1
fi
rm -f "$PLUGIN_TMP"

# 5. Download the plugin manager only when missing or empty.
if [ ! -s "$PLUGIN_MANAGER_JAR" ]; then
  mkdir -p "$(dirname "$PLUGIN_MANAGER_JAR")"
  curl -fL --retry 3 --retry-delay 2 \
    -o "$${PLUGIN_MANAGER_JAR}.tmp" \
    "https://github.com/jenkinsci/plugin-installation-manager-tool/releases/download/$${PLUGIN_MANAGER_VERSION}/jenkins-plugin-manager-$${PLUGIN_MANAGER_VERSION}.jar"

  test -s "$${PLUGIN_MANAGER_JAR}.tmp"
  mv "$${PLUGIN_MANAGER_JAR}.tmp" "$PLUGIN_MANAGER_JAR"
fi

java -jar "$PLUGIN_MANAGER_JAR" --version

# 6. Resolve plugins and dependencies.
if [ ! -f "$JENKINS_WAR" ]; then
  echo "ERROR: Jenkins WAR not found: $JENKINS_WAR"
  rpm -ql jenkins | grep -E 'jenkins\.war$' || true
  exit 1
fi

# Stage a fresh resolution without deleting installed plugins.
STAGE_NEW=$(mktemp -d "$${PLUGIN_STAGING}.new.XXXXXX")
cleanup() {
  rm -rf "$${STAGE_NEW:-}"
}
trap 'cleanup; rc=$?; echo "ERROR: line $LINENO: $BASH_COMMAND (exit=$rc)" >&2; exit "$rc"' ERR

java -jar "$PLUGIN_MANAGER_JAR" \
  --war "$JENKINS_WAR" \
  --plugin-file "$PLUGIN_LIST" \
  --plugin-download-directory "$STAGE_NEW"

# Only update installed plugin files when bytes actually differ.
if [ -n "$(rsync -rcni --out-format='%n' "$STAGE_NEW/" "$JENKINS_HOME/plugins/")" ]; then
  rsync -rc --itemize-changes "$STAGE_NEW/" "$JENKINS_HOME/plugins/"
  RESTART_REQUIRED=1
fi

rm -rf "$STAGE_NEW"
STAGE_NEW=""

# 7. Reconcile JCasC systemd configuration.
if [ -f "$JENKINS_HOME/jenkins.yaml" ]; then
  mkdir -p "$JENKINS_OVERRIDE_DIR"

  OVERRIDE_TMP=$(mktemp)
  cat > "$OVERRIDE_TMP" <<'OVERRIDE'
[Service]
Environment="CASC_JENKINS_CONFIG=/var/lib/jenkins/jenkins.yaml"
OVERRIDE

  if ! cmp -s "$OVERRIDE_TMP" "$JENKINS_OVERRIDE" 2>/dev/null; then
    install -o root -g root -m 0644 "$OVERRIDE_TMP" "$JENKINS_OVERRIDE"
    RESTART_REQUIRED=1
  fi
  rm -f "$OVERRIDE_TMP"
else
  if [ -f "$JENKINS_OVERRIDE" ] &&
     grep -q 'CASC_JENKINS_CONFIG=/var/lib/jenkins/jenkins.yaml' "$JENKINS_OVERRIDE"; then
    rm -f "$JENKINS_OVERRIDE"
    RESTART_REQUIRED=1
  fi
  echo "No jenkins.yaml found; JCasC will not be enabled."
fi

# 8. Set ownership and apply service changes.
# The Jenkins data volume is dedicated to Jenkins.
chown jenkins:jenkins "$JENKINS_HOME"
chown -R jenkins:jenkins "$JENKINS_HOME/plugins"

systemctl daemon-reload

if ! systemctl is-enabled --quiet jenkins; then
  systemctl enable jenkins
fi

if [ "$RESTART_REQUIRED" -eq 1 ]; then
  echo "Managed configuration changed; restarting Jenkins."
  systemctl restart jenkins
elif ! systemctl is-active --quiet jenkins; then
  echo "Jenkins is stopped; starting it."
  systemctl start jenkins
else
  echo "No managed changes detected; leaving Jenkins running."
fi

# 9. Wait for readiness.
READY=0
for attempt in $(seq 1 60); do
  if systemctl is-active --quiet jenkins &&
     curl --connect-timeout 3 --max-time 5 -fsS \
       http://127.0.0.1:8080/login -o /dev/null; then
    READY=1
    break
  fi
  sleep 5
done

if [ "$READY" -ne 1 ]; then
  echo "ERROR: Jenkins did not become ready."
  systemctl status jenkins --no-pager -l || true
  journalctl -u jenkins -n 100 --no-pager || true
  exit 1
fi

echo "========== Jenkins is READY =========="
systemctl status jenkins --no-pager -l
